# Copy to .env.local and fill in. Never commit real keys.

# Required: Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: model for the itinerary planner (default: claude-haiku-5-5, the cheapest)
# PLANNER_MODEL=claude-sonnet-5-5

# Optional kill-switch: set to "true" to pause trip generation (e.g. if spend spikes)
# AI_DISABLED=true

# Daily quotas (defaults: 3 trips per visitor, 200 trips total across all visitors)
# DAILY_TRIPS_PER_VISITOR=3
# DAILY_TRIPS_GLOBAL=200

# Optional: Upstash Redis (free tier) so quotas hold across serverless instances.
# Without these, quotas are tracked in memory per instance (best-effort).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
