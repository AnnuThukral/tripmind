# Copy to .env.local and fill in. Never commit real keys.

# Required: Claude API key from https://console.anthropic.com
# (TripMind always uses Claude Haiku, the cheapest model; this is not configurable.)
ANTHROPIC_API_KEY=

# Optional kill-switch: set to "true" to pause all AI features (e.g. if spend spikes)
# AI_DISABLED=true

# Daily quotas per visitor and across everyone. Defaults shown.
# DAILY_TRIPS_PER_VISITOR=3
# DAILY_TRIPS_GLOBAL=200
# DAILY_EDITS_PER_VISITOR=20
# DAILY_EDITS_GLOBAL=1000
# DAILY_IDEAS_PER_VISITOR=5
# DAILY_IDEAS_GLOBAL=300

# Optional: Upstash Redis (free tier) so quotas hold across serverless instances.
# Without these, quotas are tracked in memory per instance (best-effort).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
