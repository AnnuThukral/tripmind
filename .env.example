# Copy to .env.local and fill in. Never commit real keys.

# Required: Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: model for the itinerary planner (default: claude-haiku-5-5, the cheapest)
# PLANNER_MODEL=claude-sonnet-5-5

# Optional kill-switch: set to "true" to pause trip generation (e.g. if spend spikes)
# AI_DISABLED=true
